{
    "name": "dianaphp/rendering",
    "description": "the diana rendering package",
    "keywords": [
        "diana",
        "php",
        "framework"
    ],
    "minimum-stability": "dev",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Diana\\": "src/Diana/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Antonio Ianzano",
            "email": "ianzanoan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5.12",
        "dianaphp/lib": "dev-main",
        "ramsey/uuid": "^5.0",
        "dianaphp/sdk": "dev-main",
        "twig/twig": "^3.0",
        "dianaphp/framework": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Diana\\Tests\\": "tests/"
        }
    }
}
